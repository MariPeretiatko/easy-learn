{
  "name": "easy-learn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:unused": "node scripts/check-unused.mjs",
    "check": "npm run typecheck && npm run check:unused && npm test && npm run build && npm run check:bundle",
    "test:e2e:production": "node scripts/test-production.mjs",
    "supabase:start": "supabase start -x edge-runtime,studio,logflare,vector,supavisor,realtime,imgproxy",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:cloud:browser": "node scripts/test-cloud-browser.mjs",
    "catalog:seed": "node scripts/catalog-seed.mjs",
    "test:cloud:delete": "node scripts/test-cloud-delete.mjs",
    "cloud:types": "node scripts/generate-cloud-types.mjs",
    "test:cloud:cleanup": "node scripts/test-cloud-delete.mjs --cleanup",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "build:cloudflare": "node scripts/build-cloudflare.mjs"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.3",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.1",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.4"
  },
  "packageManager": "pnpm@10.34.7"
}
